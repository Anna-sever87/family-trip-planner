# Yandex AI Studio
YANDEX_API_KEY=ваш_api_ключ_yandex
YANDEX_FOLDER_ID=ваш_id_каталога
YANDEX_MODEL_URI=gpt://ваш_id_каталога/yandexgpt-5-lite
YANDEX_MAX_TOKENS=8000

# ИИ-обложки: отдельная платная генерация Alice AI ART через Images API.
# По умолчанию выключена. Общий лимит попыток на всё приложение за сутки UTC.
IMAGE_GENERATION_ENABLED=0
IMAGE_GENERATION_DAILY_LIMIT=10
# Если не указан, используется YANDEX_API_KEY; ключу нужны права генерации изображений.
YANDEX_ART_API_KEY=
# Пусто = art://<YANDEX_FOLDER_ID>/aliceai-image-art-3.0
YANDEX_ART_MODEL_URI=
# Относительно рабочего каталога; в Docker /data/output/covers на постоянном томе.
IMAGE_CACHE_DIR=output/covers

# Эмбеддинги YandexGPT для памяти
YANDEX_EMBEDDING_DOC_URI=emb://ваш_id_каталога/text-search-doc/latest
YANDEX_EMBEDDING_QUERY_URI=emb://ваш_id_каталога/text-search-query/latest

# Pinecone
PINECONE_API_KEY=ваш_ключ_pinecone
PINECONE_INDEX_NAME=family-trip-memory-yandex-256

# Telegram
TELEGRAM_BOT_TOKEN=токен_бота_из_BotFather

# Закрытая демонстрация: владелец и временно приглашённые проверяющие.
# Пустой список владельцев оставляет доступ закрытым; укажите свой числовой Telegram ID.
# Несколько ID разделяются запятой. Не используйте @username или токен бота.
# В старой конфигурации без ACCESS_MODE сохраняется открытый режим (open).
ACCESS_MODE=invite
ACCESS_OWNER_IDS=
# Общий лимит маршрутных попыток владельца и гостей за сутки UTC в режиме invite.
ACCESS_GLOBAL_ROUTE_DAILY_LIMIT=12
# /invite [дни]: по умолчанию 7 дней от создания, допустимо 1–30.
# /invite и /invite_one создают личную ссылку: 1 проверяющий, 5 попыток за весь срок.
# Отдельно каждому гостю: 3 попытки обложек и 3 операции памяти за срок доступа.
# Общий лимит обложек остаётся IMAGE_GENERATION_DAILY_LIMIT=10, выше.

# Суточный лимит маршрутных AI-операций владельца и пользователей открытого режима.
# У приглашённых вместо него квота приглашения: все 5 попыток можно потратить за один день.
DAILY_LIMIT=3

# Конфигурация демонстрации: городской режим по проверенным ID кандидатов.
# Предварительный план со свободными днями; редактирование в пределах проверенного набора.
# Без этой настройки код сохраняет прежнюю ветку; включают точные 1/true.
CITY_CANDIDATES_FIRST=1

# Расписание нового городского маршрута рассчитывает сервер, а не ИИ.
# Применяется только вместе с CITY_CANDIDATES_FIRST=1; регионы не переключает.
CITY_DETERMINISTIC_SCHEDULE=1

# Напоминания
REMINDER_TZ=Asia/Novosibirsk
REMINDER_DAYS_BEFORE=3

# Веб-кабинет. На сервере используйте публичный HTTPS-адрес
WEB_BASE_URL=http://127.0.0.1:8000
WEB_SESSION_SECRET=
WEB_LOGIN_TOKEN_MINUTES=15
WEB_SESSION_HOURS=24
WEB_COOKIE_SECURE=
